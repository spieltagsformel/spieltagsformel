---
import "../styles/global.css";

interface Props {
  titel: string;
  beschreibung?: string;
  // Design v3 „Bühne“: „start“ und „kapitel“ = Inhalt in voller Breite mit eigenen Kapiteln,
  // „text“ = Textspalte (höchstens 46rem) links im Raster.
  art?: "start" | "kapitel" | "text";
  // Dunkler Seitenkopf über dem Inhalt (ersetzt die h1 der Seite)
  kopf?: { vorzeile?: string; vorzeileLink?: string; titel: string; text?: string };
}
const { titel, art = "text", kopf, beschreibung = "Bundesliga in Zahlen: Unsere Formel sagt jeden Spieltag voraus – vor Anpfiff eingefroren, danach ehrlich abgerechnet." } = Astro.props;
const seitentitel = titel === "Spieltagsformel" ? "Spieltagsformel – Bundesliga in Zahlen" : `${titel} · Spieltagsformel`;
const pfad = Astro.url.pathname.replace(/\/$/, "") || "/";
const menue = [
  { href: "/", text: "Spieltag" },
  { href: "/modell", text: "Modell" },
  { href: "/100-euro-experiment", text: "100-€-Experiment" },
  { href: "/newsletter", text: "Newsletter" },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <!-- Bis zum Launch nicht in Suchmaschinen aufnehmen -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#111111" />
  </head>
  <body>
    <header class="kopf invers">
      <div class="rahmen">
        <a class="logo" href="/" aria-label="Spieltagsformel – Startseite">
          <img class="hell" src="/logo/spieltagsformel-logo-hell.svg" alt="Spieltagsformel" width="175" height="40" />
          <img class="dunkel" src="/logo/spieltagsformel-logo-dunkel.svg" alt="Spieltagsformel" width="175" height="40" />
        </a>
        <nav class="nav" aria-label="Hauptmenü">
          {menue.map((m) => (
            <a href={m.href} aria-current={pfad === m.href ? "page" : undefined}>{m.text}</a>
          ))}
        </nav>
      </div>
    </header>
    {kopf && (
      <section class="seitenkopf">
        <div class="weit">
          {kopf.vorzeile && (kopf.vorzeileLink
            ? <p class="vorzeile"><a href={kopf.vorzeileLink}>{kopf.vorzeile}</a></p>
            : <p class="vorzeile">{kopf.vorzeile}</p>)}
          <h1 class="seiten-titel">{kopf.titel}</h1>
          {kopf.text && <p class="seiten-text">{kopf.text}</p>}
        </div>
      </section>
    )}
    {art === "text" ? (
      <main class="seite"><div class="weit"><div class="spalte"><slot /></div></div></main>
    ) : (
      <main class="voll"><slot /></main>
    )}
    <footer class="fuss breit">
      <div class="rahmen">
        <nav aria-label="Rechtliches">
          <a href="/newsletter">Newsletter</a>
          <a href="/kontakt">Kontakt</a>
          <a href="/werbung">Werbung</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
        <p>Spieltagsformel ist ein unabhängiges Datenprojekt. Keine Wettempfehlungen, keine Werbung für Sportwetten.
          Spieldaten: <a href="https://www.openligadb.de">OpenLigaDB</a> (ODbL).</p>
      </div>
    </footer>
    <script is:inline>
      // Anonyme Zählung: Seitenaufruf und Klicks auf externe Links. Keine Cookies, keine Kennungen.
      (function () {
        if (!navigator.sendBeacon || location.hostname === "localhost") return;
        var senden = function (pfad, daten) {
          try { navigator.sendBeacon(pfad, new Blob([JSON.stringify(daten)], { type: "text/plain" })); } catch (e) {}
        };
        var p = new URLSearchParams(location.search);
        var utm = { s: p.get("utm_source") || "", m: p.get("utm_medium") || "", c: p.get("utm_campaign") || "" };
        senden("/api/aufruf", { seite: location.pathname, quelle: document.referrer || "", utm: utm });
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a[href]");
          if (!a) return;
          var u = new URL(a.href, location.href);
          if (u.hostname !== location.hostname) senden("/api/klick", { seite: location.pathname, ziel: u.href });
        });
      })();
    </script>
  </body>
</html>
