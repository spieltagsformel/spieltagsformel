---
import Basis from "../layouts/Basis.astro";
import { neuestesPaket, anstoss, prozent, REGEL_TEXT } from "../lib/daten.js";

const paket = neuestesPaket();
const stand = paket ? new Intl.DateTimeFormat("de-DE", { timeZone: "Europe/Berlin", dateStyle: "medium", timeStyle: "short" }).format(new Date(paket.erstellt)) : null;
const saisonText = paket ? paket.saison.replace("-", "/") : "";
---
<Basis titel="Spieltagsformel">
  <h1>Bundesliga in Zahlen</h1>
  <p class="leise">Die Formel sagt jeden Spieltag voraus. Wir frieren die Prognosen vor dem Anpfiff ein und rechnen danach ehrlich ab – auch wenn sie danebenliegt.</p>

  {paket ? (
    <section aria-labelledby="spieltag">
      <h2 id="spieltag">{paket.spieltag}. Spieltag {saisonText}: Die Formel sagt …</h2>
      <div class="legende" aria-hidden="true">
        <span><span class="punkt" style="background:var(--heim)"></span>Heimsieg</span>
        <span><span class="punkt" style="background:var(--remis)"></span>Remis</span>
        <span><span class="punkt" style="background:var(--gast)"></span>Auswärtssieg</span>
      </div>
      <ol class="spiele">
        {paket.spiele.map((s) => {
          const m = s.modell;
          return (
            <li class="spiel">
              <div class="spiel-kopf">
                <span class="paarung">{s.heim} – {s.gast}</span>
                <span class="anstoss">{anstoss(s.anstoss_utc)}</span>
              </div>
              {m ? (
                <>
                  <div class="balken" role="img"
                    aria-label={`Heimsieg ${prozent(m.p_heim)} Prozent, Remis ${prozent(m.p_remis)} Prozent, Auswärtssieg ${prozent(m.p_gast)} Prozent`}>
                    <span class="h" style={`width:${m.p_heim * 100}%`}>{prozent(m.p_heim)} %</span>
                    <span class="x" style={`width:${m.p_remis * 100}%`}>{prozent(m.p_remis)} %</span>
                    <span class="a" style={`width:${m.p_gast * 100}%`}>{prozent(m.p_gast)} %</span>
                  </div>
                  <div class="details">
                    {s.erwartete_tore && (
                      <span>Erwartete Tore <b class="zahl">{s.erwartete_tore.heim.toFixed(1)} : {s.erwartete_tore.gast.toFixed(1)}</b></span>
                    )}
                    <span>Tabellenplatz-Regel <b>{REGEL_TEXT[s.vergleich.tabellenplatz]}</b> <span class="zahl">({s.platz_heim}. gegen {s.platz_gast}.)</span></span>
                    {s.ergebnis && <span>Ergebnis <b class="zahl">{s.ergebnis.heim}:{s.ergebnis.gast}</b></span>}
                  </div>
                </>
              ) : (
                <p class="leise klein">Noch keine Modellprognose.</p>
              )}
            </li>
          );
        })}
      </ol>
      <p class="quelle">Wahrscheinlichkeiten unseres Modells ({paket.spiele[0]?.modell?.version ?? "–"}), keine Wettempfehlung. Stand: {stand} Uhr. Quelle: OpenLigaDB (ODbL), eigene Berechnung.</p>
      {paket.hinweise.length > 0 && (
        <div class="kasten hinweis klein">{paket.hinweise.map((h) => <p>{h}</p>)}</div>
      )}
    </section>
  ) : (
    <p>Die erste Prognose erscheint hier, sobald das Datenpaket für den nächsten Spieltag vorliegt.</p>
  )}

  <div class="kasten">
    <h3 style="margin-top:0">Wie messen wir die Formel?</h3>
    <p>Jede Prognose wird vor Anpfiff mit Zeitstempel gespeichert. Danach vergleichen wir sie mit einer einfachen Regel (der besser Platzierte gewinnt), mit der Einschätzung unserer Community und mit dem Markt. <a href="/modell">Mehr zum Modell</a></p>
  </div>
</Basis>
