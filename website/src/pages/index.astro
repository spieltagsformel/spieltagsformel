---
// Startseite v3 „Bühne“ (Entwurf A, freigegeben 24.11.2026): Hero mit der Geschichte des Spieltags,
// danach je Spiel eine Karte mit Formel, Markt und erwarteten Toren, die Bilanz und Experiment/Newsletter.
import Basis from "../layouts/Basis.astro";
import Balken from "../components/Balken.astro";
import Spielkarte from "../components/Spielkarte.astro";
import Vereinsstreifen from "../components/Vereinsstreifen.astro";
import {
  neuestesPaket, nachTagen, kurz, werte, abstand, heldSpiel, markierungen, zeitraum, kurzAnstoss, WIDERSPRUCH_AB,
} from "../lib/daten.js";
import Bilanz from "../components/Bilanz.astro";
import { KIT_URL } from "../lib/newsletter.js";

const paket = neuestesPaket();
const stand = paket ? new Intl.DateTimeFormat("de-DE", { timeZone: "Europe/Berlin", dateStyle: "medium", timeStyle: "short" }).format(new Date(paket.erstellt)) : null;
const tage = paket ? nachTagen(paket.spiele) : [];
const marken = paket ? markierungen(paket.spiele) : {};
const anzahl = paket ? paket.spiele.length : 0;
const ZAHLWORT = ["null", "ein", "zwei", "drei", "vier", "fünf", "sechs", "sieben", "acht", "neun", "zehn"];
const anzahlWort = ZAHLWORT[anzahl] ?? String(anzahl);

// Hero: das Spiel mit dem größten Abstand zwischen Formel und Markt
const held = paket ? heldSpiel(paket.spiele) : null;
const a = held ? abstand(held) : null;
const H = held ? kurz(held.heim) : "";
const G = held ? kurz(held.gast) : "";
let titel = paket ? `${paket.spieltag}. Spieltag` : "Bundesliga in Zahlen";
let unter = null;
if (a) {
  const widerspruch = Math.abs(a.d) >= WIDERSPRUCH_AB;
  titel = widerspruch ? "Die Formel widerspricht dem Markt." : "Formel und Markt sind sich weitgehend einig.";
  const wort = a.F[a.i] < a.M[a.i] ? "nur" : "sogar";
  const wie = a.i === 0 ? `Der Markt gibt ${H} gegen ${G}` : a.i === 2 ? `Der Markt gibt ${G} bei ${H}` : `Der Markt gibt einem Remis zwischen ${H} und ${G}`;
  unter = { start: widerspruch ? `Am deutlichsten bei ${H} gegen ${G}. ` : "Der größte Unterschied: ", wie, markt: a.M[a.i], wort, formel: a.F[a.i] };
}
const heldF = held ? werte(held.modell) : null;
const heldM = held ? werte(held.markt) : null;

---
<Basis titel="Spieltagsformel" art="start">
  <section class="buehne" aria-labelledby="held-titel">
    <div class="weit">
      {paket && <p class="vorzeile">{paket.spieltag}. Spieltag, {zeitraum(paket.spiele)}</p>}
      <h1 id="held-titel" class="held-titel">{titel}</h1>
      {unter ? (
        <p class="held-unter">{unter.start}{unter.wie} <span class="zahl">{unter.markt} %</span>, die Formel {unter.wort} <span class="zahl">{unter.formel} %</span>.</p>
      ) : (
        <p class="held-unter">Die Formel sagt jeden Spieltag voraus. Wir frieren die Prognosen vor dem Anpfiff ein und rechnen danach ehrlich ab, auch wenn sie danebenliegt.</p>
      )}
    </div>
    {held && heldF && (
      <div class="weit duell">
        <div class="duell-kopf">
          <span class="verein"><Vereinsstreifen name={held.heim} gross />{H}</span>
          <span class="zahl leise">{kurzAnstoss(held.anstoss_utc)}</span>
          <span class="verein">{G}<Vereinsstreifen name={held.gast} gross /></span>
        </div>
        <div class="duell-zeile"><span>Formel</span><Balken werte={heldF} wer="Formel" groesse="gross" /></div>
        {heldM && <div class="duell-zeile"><span class="leise">Markt</span><Balken werte={heldM} wer="Markt" groesse="gross" /></div>}
        <div class="legende">
          <span class="legende-farben">
            <span><i class="heim"></i>Heimsieg</span><span><i class="remis"></i>Remis</span><span><i class="gast"></i>Auswärtssieg</span>
          </span>
          {held.markt?.buchmacher && <span>Markt: Durchschnitt von {held.markt.buchmacher} Buchmachern, ohne Marge</span>}
        </div>
      </div>
    )}
    <div class="weit held-links">
      {paket && <a class="knopf" href="#spiele">{anzahl === 9 ? "Alle neun Spiele" : "Alle Spiele"}</a>}
      <a class="link-hell" href="/modell">Warum die Formel anders rechnet</a>
    </div>
  </section>

  {paket ? (
    <section id="spiele" class="kapitel" aria-labelledby="spiele-titel">
      <div class="weit">
        <h2 id="spiele-titel" class="kapitel-titel">Alle {anzahlWort === "neun" ? "neun Spiele" : "Spiele"}.</h2>
        <p class="kapitel-text">Für jedes Spiel: was die Formel rechnet, was der Markt erwartet und wie viele Tore wir erwarten.</p>
        <p class="legende-farben dunkel-auf-hell" aria-hidden="true">
          <span><i class="heim"></i>Heimsieg</span><span><i class="remis"></i>Remis</span><span><i class="gast"></i>Auswärtssieg</span>
        </p>
        {tage.map((t) => (
          <div class="tag-block">
            <h3 class="tag-titel">{t.tag}</h3>
            <div class="karten">
              {t.zeiten.flatMap((z) => z.spiele.map((s) => (
                <Spielkarte s={s} uhr={z.uhr} markierung={marken[s.id]} />
              )))}
            </div>
          </div>
        ))}
        <p class="quelle">Formel = unser Modell ({paket.spiele[0]?.modell?.version ?? "–"}). Markt = Durchschnitt der Buchmacher, ohne Marge. Erwartete Tore aus dem Vergleichsmodell (Dixon-Coles). Form: S Sieg, U Unentschieden, N Niederlage. Tabellen-Regel: Der besser Platzierte gewinnt, bei einem Platz Abstand Remis. Vereinsfarben ohne Wappen, nur zur Orientierung. Keine Wettempfehlung. Stand: {stand} Uhr. Quellen: OpenLigaDB (ODbL), The Odds API (Quoten), eigene Berechnung.</p>
        {paket.hinweise.length > 0 && (
          <div class="kasten hinweis klein">{paket.hinweise.map((h) => <p>{h}</p>)}</div>
        )}
      </div>
    </section>
  ) : (
    <section class="kapitel"><div class="weit"><p>Die erste Prognose erscheint hier, sobald das Datenpaket für den nächsten Spieltag vorliegt.</p></div></section>
  )}

  <section class="kapitel grau" aria-labelledby="bilanz-titel">
    <div class="weit">
      <h2 id="bilanz-titel" class="kapitel-titel schmal">Wie gut rechnet die Formel bisher?</h2>
      <p class="kapitel-text">Gezählt werden nur Spiele mit Prognosen, die vor dem Anpfiff eingefroren waren. Der RPS misst, wie gut die Wahrscheinlichkeiten zum Ergebnis passten. Kleiner ist besser.</p>
      <Bilanz />
    </div>
  </section>

  <section class="kapitel tinte">
    <div class="weit zweispaltig">
      <div>
        <h2 class="kapitel-titel klein-titel">100 € und eine Formel.</h2>
        <p>Was würde aus 100 €, wenn man der Formel folgt? Ab dem ersten Spieltag nach der Winterpause rechnen wir es jede Woche durch. Ohne echtes Geld.</p>
        <p><a class="link-hell" href="/100-euro-experiment">Die Regeln des Experiments</a></p>
        <p class="klein leise">Rechnerisches Experiment ohne echtes Geld. 18+ · Glücksspiel kann süchtig machen. Hilfe: <a class="link-leise" href="https://www.check-dein-spiel.de/">check-dein-spiel.de</a></p>
      </div>
      <div>
        <h2 class="kapitel-titel klein-titel">Nachspielzeit, jeden Mittwoch.</h2>
        <p>Kontostand, Zahl der Woche und das Logbuch der Formel. In etwa vier Minuten gelesen, kostenlos, jederzeit abbestellbar.</p>
        <p><a class="knopf" href={KIT_URL} rel="noopener">Kostenlos abonnieren</a></p>
        <p class="klein leise">Du kommst auf eine Seite unseres Versanddienstleisters Kit (USA) und bekommst zuerst eine E-Mail zur Bestätigung. Mehr in der <a class="link-leise" href="/datenschutz">Datenschutzerklärung</a>.</p>
      </div>
    </div>
  </section>
</Basis>
