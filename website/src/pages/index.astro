---
import Basis from "../layouts/Basis.astro";
import { neuestesPaket, anstoss, prozent, komma, skala, kurz, REGEL_TEXT } from "../lib/daten.js";

const paket = neuestesPaket();
const stand = paket ? new Intl.DateTimeFormat("de-DE", { timeZone: "Europe/Berlin", dateStyle: "medium", timeStyle: "short" }).format(new Date(paket.erstellt)) : null;
const saisonText = paket ? paket.saison.replace("-", "/") : "";
---
<Basis titel="Spieltagsformel">
  <h1>Bundesliga in Zahlen</h1>
  <p class="leise">Die Formel sagt jeden Spieltag voraus. Wir frieren die Prognosen vor dem Anpfiff ein und rechnen danach ehrlich ab – auch wenn sie danebenliegt.</p>

  {paket ? (
    <section aria-labelledby="spieltag">
      <h2 id="spieltag">{paket.spieltag}. Spieltag {saisonText}: Die Formel sagt …</h2>
      <p class="leise klein">Der Punkt zeigt, zu welcher Seite die Formel tendiert. In der Mitte ist das Spiel offen.</p>
      <ol class="spiele">
        {paket.spiele.map((s) => {
          const m = s.modell;
          const k = m ? skala(s) : null;
          return (
            <li class="spiel">
              <div class="team" title={s.heim}>{kurz(s.heim)}<small>{s.platz_heim}. · Form {s.form_heim || "–"}</small></div>
              {k ? (
                <div class="skala" role="img" aria-label={`${k.label}. Heimsieg ${prozent(m.p_heim)} Prozent, Remis ${prozent(m.p_remis)} Prozent, Auswärtssieg ${prozent(m.p_gast)} Prozent`}>
                  <span class="rand links" aria-hidden="true">← stärker</span>
                  <span class="rand rechts" aria-hidden="true">stärker →</span>
                  <span class="achse"></span>
                  <span class="mitte"></span>
                  <span class="zone" style={`left:${k.zoneLinks}%;width:${k.zoneBreite}%`}></span>
                  <span class="punkt-gross" style={`left:${k.pos}%`}></span>
                  <span class="label" style={`left:${Math.max(14, Math.min(86, k.pos))}%`}>{k.label}</span>
                </div>
              ) : (
                <div class="skala leise klein">Noch keine Prognose</div>
              )}
              <div class="team gast" title={s.gast}>{kurz(s.gast)}<small>{s.platz_gast}. · Form {s.form_gast || "–"}</small></div>
              <div class="meta">
                <span>{anstoss(s.anstoss_utc)}</span>
                {s.erwartete_tore && <span>Erwartete Tore <b>{komma(s.erwartete_tore.heim)} : {komma(s.erwartete_tore.gast)}</b></span>}
                {m && <span>Formel <b>{prozent(m.p_heim)}</b> · {prozent(m.p_remis)} · <b>{prozent(m.p_gast)}</b> %</span>}
                {s.markt && <span>Markt {prozent(s.markt.p_heim)} · {prozent(s.markt.p_remis)} · {prozent(s.markt.p_gast)} %</span>}
                <span>Tabellen-Regel: {REGEL_TEXT[s.vergleich.tabellenplatz]}</span>
                {s.ergebnis && <span>Ergebnis <b>{s.ergebnis.heim}:{s.ergebnis.gast}</b></span>}
              </div>
            </li>
          );
        })}
      </ol>
      <p class="quelle">Formel und Markt = Wahrscheinlichkeiten für Heimsieg · Remis · Auswärtssieg in Prozent (Markt: Durchschnitt der Buchmacher, ohne Marge). Modell {paket.spiele[0]?.modell?.version ?? "–"}. Form: S = Sieg, U = Unentschieden, N = Niederlage. Keine Wettempfehlung. Stand: {stand} Uhr. Quellen: OpenLigaDB (ODbL), The Odds API (Quoten), eigene Berechnung.</p>
      {paket.hinweise.length > 0 && (
        <div class="kasten hinweis klein">{paket.hinweise.map((h) => <p>{h}</p>)}</div>
      )}
    </section>
  ) : (
    <p>Die erste Prognose erscheint hier, sobald das Datenpaket für den nächsten Spieltag vorliegt.</p>
  )}

  <div class="kasten">
    <h3 style="margin-top:0">Wie messen wir die Formel?</h3>
    <p>Jede Prognose wird vor Anpfiff mit Zeitstempel gespeichert. Danach vergleichen wir sie mit einer einfachen Regel (der besser Platzierte gewinnt), mit der Einschätzung unserer Community und mit dem Markt. <a href="/modell">Mehr zum Modell</a></p>
  </div>
</Basis>
