---
import Basis from "../../layouts/Basis.astro";
import Bilanz from "../../components/Bilanz.astro";
import { Content as Logbuch } from "../../../../MODELL-LOGBUCH.md";
import { waechterStand } from "../../lib/waechter.js";

const w = waechterStand();
---
<Basis titel="Modell-Logbuch" art="kapitel" beschreibung="Jede Beobachtung und jede Änderung an der Formel – mit Datum, Grund und Wirkung. Dazu die laufende Bilanz gegen Markt und Vergleichsmodell."
  kopf={{ vorzeile: "Das Modell", vorzeileLink: "/modell", titel: "Modell-Logbuch", text: "Jede Beobachtung und jede Änderung an der Formel, mit Datum, Grund und Wirkung. Nach einem einzelnen Spieltag ändern wir nichts: Erst mehrere Spieltage zeigen, ob etwas Zufall ist oder ein Muster." }}>

  <section class="kapitel grau" aria-labelledby="bilanz">
    <div class="weit">
      <h2 id="bilanz" class="kapitel-titel">Aktuelle Bilanz{w ? ` ${w.saison.replace("-", "/")}` : ""}.</h2>
      <p class="kapitel-text">Alle Prognosen vor dem Anpfiff eingefroren. RPS und Brier: kleiner ist besser. Wird nach jedem Spieltag automatisch aktualisiert. Wenige Spiele bedeuten viel Zufall, die Bilanz zählt erst über viele Spieltage.</p>
      <Bilanz fazit={false} brier />
    </div>
  </section>

  <section class="kapitel" aria-labelledby="eintraege">
    <div class="weit">
      <h2 id="eintraege" class="kapitel-titel">Einträge.</h2>
      <div class="spalte">
        <article class="logbuch">
          <Logbuch />
        </article>
      </div>
    </div>
  </section>
</Basis>
